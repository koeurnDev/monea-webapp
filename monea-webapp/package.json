    "zod": "^4.3.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "puppeteer": "^25.13.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
