{
  "name": "monea-platform",
  "version": "1.2.3",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 3001",
    "worker": "npm --prefix ..\\monea-api-worker run worker:dev",
    "worker:dev": "npm --prefix ..\\monea-api-worker run worker:dev",
    "worker:deploy": "npm --prefix ..\\monea-api-worker run worker:deploy",
    "build": "tsc && node scripts/build.mjs && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "build:prerender": "npm run build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --ignore-pattern \"*.d.ts\"",
    "postinstall": "prisma generate",
    "test:mobile": "node scripts/mobile-performance-test.js",
    "test:sw": "node scripts/sw-contract-check.mjs",
    "test:pages-assets": "node --experimental-strip-types --test scripts/pages-asset-fallback.test.mjs",
    "test:nav": "node scripts/check-navigation.mjs",
    "test:templates": "node --experimental-strip-types --test scripts/template-contract.test.mjs",
    "photos:prepare": "node scripts/prepare-wedding-photos.mjs",
    "analyze": "vite build --mode analyze",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "seo:validate": "echo 'Run: https://search.google.com/test/rich-results' && echo 'Paste URL to validate structured data'"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@hono/zod-validator": "^0.9.0",
    "@hookform/resolvers": "^5.2.2",
    "@marsidev/react-turnstile": "^1.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "@next/bundle-analyzer": "^14.2.3",
    "@otplib/preset-browser": "^12.0.1",
    "@otplib/preset-default": "^12.0.1",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@scure/base": "^2.0.0",
    "@sentry/react": "^10.70.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
